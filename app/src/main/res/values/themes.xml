<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Base.Theme.Clank" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/clank_background_light</item>
    <item name="android:colorBackground">@color/clank_background_light</item>
    <item name="colorSurface">@color/clank_background_light</item>
    <item name="colorOnSurface">@color/color_negrita</item>
  </style>

  <style name="Theme.Clank" parent="Base.Theme.Clank">
    <item name="android:fontFamily">@font/poppins_family</item>
    <item name="fontFamily">@font/poppins_family</item>
  </style>

  <style name="RoundedImage">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">12dp</item>
  </style>

  <!-- Crear -->
  <style name="Crear" />

  <style name="Crear.LabelSeccion">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginStart">24dp</item>
    <item name="android:fontFamily">@font/poppins_semibold</item>
    <item name="android:textColor">@color/color_clank_activo</item>
    <item name="android:textSize">@dimen/hoja_opciones_titulo_text_size</item>
    <item name="android:textStyle">bold</item>
  </style>

  <!-- Botones -->
  <style name="Widget.Clank.BotonPrincipal" parent="">
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:padding">0dp</item>
    <item name="android:background">@drawable/bg_boton_principal</item>
    <item name="android:fontFamily">@font/poppins_semibold</item>
    <item name="android:gravity">center</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/clank_background_light</item>
    <item name="android:textSize">14sp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <style name="Widget.Clank.BotonSecundario" parent="">
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:paddingStart">0dp</item>
    <item name="android:paddingEnd">0dp</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="android:background">@drawable/bg_boton_secundario</item>
    <item name="android:fontFamily">@font/poppins_semibold</item>
    <item name="android:gravity">center</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/color_texto_inactivo</item>
    <item name="android:textSize">18sp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <!-- Casillas codigo recuperar contrasenya -->
  <style name="EstiloCasillaCodigoRecuperacion">
    <item name="android:layout_width">@dimen/codigo_recuperacion_contrasenya_tamanyo_casilla</item>
    <item name="android:layout_height">@dimen/codigo_recuperacion_contrasenya_tamanyo_casilla</item>
    <item name="android:layout_marginStart">@dimen/codigo_recuperacion_contrasenya_margen_horizontal_casilla</item>
    <item name="android:layout_marginEnd">@dimen/codigo_recuperacion_contrasenya_margen_horizontal_casilla</item>
    <item name="android:background">@drawable/bg_casilla_codigo_recuperacion</item>
    <item name="android:fontFamily">@font/poppins_regular</item>
    <item name="android:gravity">center</item>
    <item name="android:inputType">number</item>
    <item name="android:maxLength">1</item>
    <item name="android:maxLines">1</item>
    <item name="android:padding">0dp</item>
    <item name="android:textColor">@color/color_negrita</item>
    <item name="android:textSize">@dimen/codigo_recuperacion_contrasenya_texto_casilla</item>



  </style>

</resources>
