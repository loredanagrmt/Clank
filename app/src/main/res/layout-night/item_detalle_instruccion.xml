<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/crear_campo_margin_top"
    app:cardBackgroundColor="@color/color_boton_inactivo"
    app:cardCornerRadius="@dimen/detalle_instruccion_card_radius"
    app:cardElevation="@dimen/elevation_none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/detalle_instruccion_min_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/detalle_instruccion_padding_horizontal"
        android:paddingTop="@dimen/detalle_instruccion_padding_vertical"
        android:paddingEnd="@dimen/detalle_instruccion_padding_horizontal"
        android:paddingBottom="@dimen/detalle_instruccion_padding_vertical">

        <TextView
            android:id="@+id/tvNumeroInstruccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/tvTextoInstruccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/detalle_instruccion_texto_margin_top"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/text_body" />

        <ImageView
            android:id="@+id/ivImagenInstruccion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/detalle_instruccion_imagen_height"
            android:layout_marginTop="@dimen/detalle_instruccion_imagen_margin_top"
            android:contentDescription="@string/tarjeta_portada_desc"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>