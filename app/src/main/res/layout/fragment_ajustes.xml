<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clank_background_light"
    android:orientation="vertical">

    <View
        android:id="@+id/view_toolbar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/row_notificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/icon_notificaciones"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_notificacion" />

                <TextView
                    android:id="@+id/label_notificaciones"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Notificaciones"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_notificaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/selector_switch" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_contactar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_contactar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_contacta_nosotros" />

                <TextView
                    android:id="@+id/label_contactar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Contacta con nosotr@s"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita"
                    android:fontFamily="@font/poppins_medium"/>

                <ImageView
                    android:id="@+id/icon_play_contactar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_play"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_alto_contraste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/icon_alto_contraste"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_alto_contraste" />

                <TextView
                    android:id="@+id/label_alto_contraste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Alto contraste"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_alto_contraste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/selector_switch" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_tema_oscuro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/icon_tema_oscuro"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_tema_oscuro" />

                <TextView
                    android:id="@+id/label_tema_oscuro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Tema oscuro"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_tema_oscuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:track="@drawable/selector_switch"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_lenguaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_lenguaje"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_idioma"
                   />

                <TextView
                    android:id="@+id/label_lenguaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lenguaje"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita"
                    android:fontFamily="@font/poppins_medium"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_cambiar_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_cambiar_contrasena"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_cambiar_contrasenya" />

                <TextView
                    android:id="@+id/label_cambiar_contrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Cambiar contraseña"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_cerrar_sesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_cerrar_sesion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_cerrar_sesion"/>

                <TextView
                    android:id="@+id/label_cerrar_sesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Cerrar sesión"
                    android:textSize="16sp"
                    android:textColor="@color/color_negrita" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_borrar_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/label_borrar_cuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrar cuenta"
                    android:textSize="14sp"
                    android:textColor="@color/color_clank_activo" />

            </LinearLayout>

        </LinearLayout>

</LinearLayout>
