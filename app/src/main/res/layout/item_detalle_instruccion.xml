<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:layout_marginBottom="10dp"
  android:background="@drawable/bg_input"
  android:padding="14dp">

  <TextView
    android:id="@+id/tvNumeroInstruccion"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/poppins_semibold"
    android:textColor="@color/color_clank_activo"
    android:textSize="@dimen/text_body_small"
    android:layout_marginBottom="4dp" />

  <TextView
    android:id="@+id/tvTextoInstruccion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/poppins_family"
    android:textColor="@color/color_negrita"
    android:textSize="@dimen/text_body"
    android:lineSpacingMultiplier="1.4" />

  <ImageView
    android:id="@+id/ivImagenInstruccion"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginTop="10dp"
    android:scaleType="centerCrop"
    android:visibility="gone"
    android:contentDescription="@string/crear_anyadir_foto_paso" />

</LinearLayout>
