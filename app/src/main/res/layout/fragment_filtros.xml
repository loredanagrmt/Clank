<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/clank_background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/chipGroupCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="@dimen/screen_margin_vertical"
            android:paddingBottom="@dimen/bottom_nav_height"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:alignItems="flex_start" />

      <TextView
        android:id="@+id/tvErrorFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_family"
        android:text="@string/error_generico"
        android:textColor="@color/color_error"
        android:textSize="@dimen/text_body_small"
        android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
