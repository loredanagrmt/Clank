<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.idioma.ElegirIdiomaFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorFondoIdioma"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_clank_activo"
        android:paddingStart="@dimen/splash_horizontal_padding"
        android:paddingEnd="@dimen/splash_horizontal_padding">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_clank_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvAppNameIdioma"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.42"
            app:layout_constraintWidth_percent="0.60"
            app:layout_constraintDimensionRatio="1:1" />

        <TextView
            android:id="@+id/tvAppNameIdioma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_title_margin_top"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/cardview_light_background"
            android:textSize="@dimen/splash_title_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/appLogo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/viewOverlayOscuro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

</FrameLayout>