<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.idioma.ElegirIdiomaFragment">

    <LinearLayout
        android:id="@+id/contenedorLogoIdioma"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6BA587"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="255dp"
            android:layout_height="255dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_clank_logo" />

        <TextView
            android:id="@+id/tvAppNameIdioma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/app_name"
            android:textColor="@color/cardview_light_background"
            android:textSize="63.84sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:id="@+id/viewOverlayOscuro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

</FrameLayout>