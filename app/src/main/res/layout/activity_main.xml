<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- Navbar superior global -->
  <include
      android:id="@+id/navbar"
      layout="@layout/navbar_superior"
      android:layout_width="0dp"
      android:layout_height="@dimen/crear_cabecera_height"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />


  <androidx.fragment.app.FragmentContainerView
      android:id="@+id/nav_host_fragment"
      android:name="androidx.navigation.fragment.NavHostFragment"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:defaultNavHost="true"
      app:navGraph="@navigation/nav_graph"
      app:layout_constraintTop_toBottomOf="@id/navbar"
      app:layout_constraintBottom_toTopOf="@id/frameBottomBar"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Bottom bar global. -->
  <FrameLayout
      android:id="@+id/frameBottomBar"
      android:layout_width="0dp"
      android:layout_height="@dimen/bottombar_alto_contenedor"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <include
        android:id="@+id/bottomBar"
        layout="@layout/bottom_bar" />

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>