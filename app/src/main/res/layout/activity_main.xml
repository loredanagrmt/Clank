<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/nav_host_fragment"
    android:name="androidx.navigation.fragment.NavHostFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:defaultNavHost="true"
    app:navGraph="@navigation/nav_graph" />

  <!-- Navbar (RECORDAR: ocultar en Logo, Idioma, InicioSesion, Registro y CompletarPerfil)-->
  <include
    android:id="@+id/navbar"
    layout="@layout/navbar_superior"
    android:layout_width="match_parent"
    android:layout_height="@dimen/crear_cabecera_height"
    android:layout_gravity="top"
    android:visibility="gone" />

  <!--   Bottomnavigation (RECORDAR: ocultar en Logo e Idioma, Portada, Bienvenida, InicioSesion,-->
  <!--  Registro, EditarPerfil, CompletarPerfil, CambiarContrasenia, BorrarCuenta, CerrarSesion, OpcionesClankPerfil,-->
  <!--   OpcionesCLankDetalle, OpcionesColeccion, Borrar y  Publicar) -->
  <FrameLayout
    android:id="@+id/frameBottomBar"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_gravity="bottom"
    android:visibility="gone">

    <include
      android:id="@+id/bottomBar"
      layout="@layout/bottom_bar" />

  </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
