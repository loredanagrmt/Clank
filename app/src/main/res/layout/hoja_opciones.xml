<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hoja"
    android:paddingTop="@dimen/hoja_opciones_padding_top"
    android:paddingBottom="@dimen/hoja_opciones_padding_bottom"
    android:paddingStart="@dimen/hoja_opciones_padding_horizontal"
    android:paddingEnd="@dimen/hoja_opciones_padding_horizontal">

    <TextView
        android:id="@+id/tituloPanelOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hoja_opciones_titulo_margin_bottom"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/color_clank_activo"
        android:textSize="@dimen/hoja_opciones_titulo_text_size"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textoConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hoja_opciones_confirmacion_margin_bottom"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/color_negrita"
        android:textSize="@dimen/hoja_opciones_confirmacion_text_size"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contenedorBotonesConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hoja_opciones_botones_alto"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/hoja_opciones_botones_gap">

            <include
                android:id="@+id/includeBotonCancelar"
                layout="@layout/bt_secundario" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <include
                android:id="@+id/includeBotonConfirmar"
                layout="@layout/bt_principal" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>