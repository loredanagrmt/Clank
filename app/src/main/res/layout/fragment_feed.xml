<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/clank_background_light">

  <!--navbar superior con botón filtros -->
  <include
    android:id="@+id/navbar"
    layout="@layout/navbar_superior"
    android:layout_width="0dp"
    android:layout_height="@dimen/crear_cabecera_height"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <!-- lista de clanks-->
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvFeed"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/feed_padding_horizontal"
    android:paddingTop="@dimen/feed_padding_top"
    android:paddingBottom="@dimen/bottom_nav_height"
    app:layout_constraintTop_toBottomOf="@id/navbar"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <!--estado vacío -->
  <TextView
    android:id="@+id/tvFeedVacio"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="@string/feed_vacio"
    android:fontFamily="@font/poppins_family"
    android:textColor="@color/color_texto_inactivo"
    android:textSize="@dimen/text_body"
    android:gravity="center"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/navbar"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <FrameLayout
      android:id="@+id/overlayCargandoFeed"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/clank_background_light"
      android:clickable="true"
      android:focusable="true"
      android:visibility="visible"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <include
        layout="@layout/vista_cargando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
