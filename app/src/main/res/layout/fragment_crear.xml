<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clank_background_light"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/crear_padding_bottom">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/crear_cabecera_height"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

      <ImageButton
          android:id="@+id/btnCrearVolver"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_centerVertical="true"
          android:layout_alignParentStart="true"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:padding="10dp"
          android:src="@drawable/ic_flecha_atras"
          app:tint="@color/color_texto_btprincipal" />

      <TextView
          android:id="@+id/tvTituloCrear"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:fontFamily="@font/poppins_semibold"
          android:text="@string/crear_titulo"
          android:textColor="@color/color_texto_btprincipal"
          android:textSize="@dimen/text_header_title" />

      <ImageButton
          android:id="@+id/btnCrearEliminar"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_centerVertical="true"
          android:layout_alignParentEnd="true"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:padding="10dp"
          android:src="@drawable/ic_delete"
          app:tint="@color/color_texto_btprincipal" />

    </RelativeLayout>
    
    

    <!-- Botones publicar y boceto-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

      <include
          android:id="@+id/btnPublicar"
          layout="@layout/bt_principal"
          android:layout_width="0dp"
          android:layout_height="@dimen/crear_btn_publicar_height"
          android:layout_weight="1"
          android:layout_marginEnd="@dimen/crear_btn_publicar_gap" />

      <include
          android:id="@+id/btnGuardarBoceto"
          layout="@layout/bt_principal"
          android:layout_width="0dp"
          android:layout_height="@dimen/crear_btn_publicar_height"
          android:layout_weight="1"
          android:layout_marginStart="@dimen/crear_btn_publicar_gap" />

    </LinearLayout>

    <!--  Portada  -->
    <FrameLayout
        android:id="@+id/framePortada"
        android:layout_width="match_parent"
        android:layout_height="@dimen/crear_portada_height"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:focusable="true">

      <ImageView
          android:id="@+id/ivPortadaPreview"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:visibility="gone" />

      <LinearLayout
          android:id="@+id/llAnyadirPortada"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:gravity="center"
          android:orientation="vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_mas" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/crear_campo_margin_top"
            android:fontFamily="@font/poppins_family"
            android:text="@string/crear_anyadir_portada"
            android:textColor="@color/color_texto_inactivo"
            android:textSize="@dimen/text_body_small" />

      </LinearLayout>

    </FrameLayout>

    <!--  Título  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_primera_seccion_margin_top"
        android:text="@string/crear_campo_titulo" />

    <EditText
        android:id="@+id/etTitulo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:background="@drawable/bg_input"
        android:fontFamily="@font/poppins_family"
        android:hint="@string/crear_hint_titulo"
        android:inputType="textCapSentences"
        android:paddingHorizontal="@dimen/space_l"
        android:textColor="@color/color_negrita"
        android:textColorHint="@color/color_texto_inactivo"
        android:textSize="@dimen/text_body"
        android:maxLines="1"
        android:imeOptions="actionNext" />

    <!--  Descripción del clank  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_segunda_seccion_margin_top"
        android:text="@string/crear_campo_descripcion" />

    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:background="@drawable/bg_input"
        android:fontFamily="@font/poppins_family"
        android:gravity="top|start"
        android:hint="@string/crear_hint_descripcion"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="4"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="14dp"
        android:textColor="@color/color_negrita"
        android:textColorHint="@color/color_texto_inactivo"
        android:textSize="@dimen/text_body" />

    <!--  Tiempo  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_primera_seccion_margin_top"
        android:text="@string/crear_campo_tiempo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <!-- Margen izdo -->
      <Space
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="2" />

      <ImageButton
          android:id="@+id/btnTiempoCohete"
          android:layout_width="@dimen/crear_btn_tiempo_size"
          android:layout_height="@dimen/crear_btn_tiempo_size"
          android:background="@drawable/bg_boton_tiempo"
          android:padding="@dimen/crear_btn_tiempo_padding"
          android:scaleType="fitCenter"
          android:adjustViewBounds="true"
          android:src="@drawable/ic_cohete"
          app:tint="@color/color_texto_inactivo" />

      <!--hueco entre botones tiempo -->
      <Space
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="1.5" />

      <ImageButton
          android:id="@+id/btnTiempoLiebre"
          android:layout_width="@dimen/crear_btn_tiempo_size"
          android:layout_height="@dimen/crear_btn_tiempo_size"
          android:background="@drawable/bg_boton_tiempo"
          android:padding="@dimen/crear_btn_tiempo_padding"
          android:scaleType="fitCenter"
          android:adjustViewBounds="true"
          android:src="@drawable/ic_liebre"
          app:tint="@color/color_texto_inactivo" />

      <!-- hueco entre botones tiempo -->
      <Space
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="1.5" />

      <ImageButton
          android:id="@+id/btnTiempoTortuga"
          android:layout_width="@dimen/crear_btn_tiempo_size"
          android:layout_height="@dimen/crear_btn_tiempo_size"
          android:background="@drawable/bg_boton_tiempo"
          android:padding="@dimen/crear_btn_tiempo_padding"
          android:scaleType="fitCenter"
          android:adjustViewBounds="true"
          android:src="@drawable/ic_tortuga"
          app:tint="@color/color_texto_inactivo" />

      <!-- Margen dcho -->
      <Space
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:layout_weight="2" />

    </LinearLayout>

    <!--  materiales  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_seccion_margin_top"
        android:text="@string/crear_campo_materiales" />

    <LinearLayout
        android:id="@+id/llContenedorMateriales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top">

      <include
          android:id="@+id/btnAnyadirMaterial"
          layout="@layout/bt_secundario"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/crear_btn_publicar_height" />

    </LinearLayout>

    <!--  Herramientas  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_seccion_margin_top"
        android:text="@string/crear_campo_herramientas" />

    <LinearLayout
        android:id="@+id/llContenedorHerramientas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top">

      <include
          android:id="@+id/btnAnyadirHerramienta"
          layout="@layout/bt_secundario"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/crear_btn_publicar_height" />

    </LinearLayout>

    <!--  Instruccionrs  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_seccion_margin_top"
        android:text="@string/crear_campo_instrucciones" />

    <LinearLayout
        android:id="@+id/llContenedorInstrucciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top">

      <include
          android:id="@+id/btnAnyadirInstruccion"
          layout="@layout/bt_secundario"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/crear_btn_publicar_height" />

    </LinearLayout>

    <!--  Categorias  -->
    <TextView
        style="@style/Crear.LabelSeccion"
        android:layout_marginTop="@dimen/crear_seccion_margin_top"
        android:text="@string/crear_campo_categorias" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flexboxCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/crear_campo_margin_top"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
