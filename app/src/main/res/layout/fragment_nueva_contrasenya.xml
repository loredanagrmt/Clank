<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clank_background_light"
    tools:context=".ui.nuevaContrasenya.NuevaContrasenyaFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollNuevaContrasenya"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/contenedorBotonNuevaContrasenya"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/nueva_contrasenya_padding_horizontal"
            android:paddingTop="@dimen/nueva_contrasenya_padding_superior_contenido"
            android:paddingEnd="@dimen/nueva_contrasenya_padding_horizontal">

            <TextView
                android:id="@+id/tvTituloNuevaContrasenya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/nueva_contrasenya_titulo_contenido"
                android:textColor="@color/color_negrita"
                android:textSize="@dimen/nueva_contrasenya_texto_titulo_contenido" />

            <TextView
                android:id="@+id/tvDescripcionNuevaContrasenya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nueva_contrasenya_margen_descripcion"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="@dimen/nueva_contrasenya_interlineado_descripcion"
                android:text="@string/nueva_contrasenya_descripcion"
                android:textColor="@color/color_negrita"
                android:textSize="@dimen/nueva_contrasenya_texto_descripcion" />

            <include
                android:id="@+id/inputNuevaContrasenya"
                layout="@layout/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nueva_contrasenya_margen_primer_input" />

            <include
                android:id="@+id/inputRepetirNuevaContrasenya"
                layout="@layout/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/contenedorBotonNuevaContrasenya"
        android:layout_width="0dp"
        android:layout_height="@dimen/nueva_contrasenya_altura_footer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/btContinuarNuevaContrasenya"
            layout="@layout/bt_principal"
            android:layout_width="@dimen/nueva_contrasenya_ancho_boton"
            android:layout_height="@dimen/nueva_contrasenya_alto_boton"
            android:layout_gravity="center" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/capaPopup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/color_sombra_popup"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/popup"
                layout="@layout/pop_up"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/popup_margen_horizontal"
                android:layout_marginEnd="@dimen/popup_margen_horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>