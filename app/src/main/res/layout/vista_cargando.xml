<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_cargando">

    <com.clank.app.ui.comun.ThemedLottieAnimationView
        android:id="@+id/lottieCargando"
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="center_horizontal" />


    <TextView
        android:id="@+id/textViewLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="@string/comun_espere_un_momento"
        android:fontFamily="@font/poppins_family"
        android:textColor="@color/color_negrita"
        android:textSize="@dimen/text_body" />

</LinearLayout>
