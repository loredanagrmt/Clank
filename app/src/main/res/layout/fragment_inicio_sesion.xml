<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clank_background_light">

    <View
        android:id="@+id/spacerTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTituloInicioSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.7" />

    <TextView
        android:id="@+id/tvTituloInicioSesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/inicio_sesion_titulo"
        android:textColor="@color/color_clank_activo"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/spacerTop"
        app:layout_constraintBottom_toTopOf="@id/spacerTituloFormulario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/spacerTituloFormulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloInicioSesion"
        app:layout_constraintBottom_toTopOf="@id/contenedorFormulario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1.9" />

    <LinearLayout
        android:id="@+id/contenedorFormulario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/spacerTituloFormulario"
        app:layout_constraintBottom_toTopOf="@id/spacerFormularioBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/inputCorreo"
            layout="@layout/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/inputContrasena"
            layout="@layout/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <View
        android:id="@+id/spacerFormularioBotones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorFormulario"
        app:layout_constraintBottom_toTopOf="@id/contenedorBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1.0" />

    <LinearLayout
        android:id="@+id/contenedorBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/spacerFormularioBotones"
        app:layout_constraintBottom_toTopOf="@id/spacerBotonesOlvido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.52">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp">

            <include
                android:id="@+id/btnIniciarSesion"
                layout="@layout/bt_secundario"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <include
                android:id="@+id/btnRegistrarse"
                layout="@layout/bt_secundario"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </LinearLayout>

    <View
        android:id="@+id/spacerBotonesOlvido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorBotones"
        app:layout_constraintBottom_toTopOf="@id/tvOlvidoContrasena"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.8" />

    <TextView
        android:id="@+id/tvOlvidoContrasena"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/olvido_contrasena"
        android:textColor="@color/color_negrita"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/spacerBotonesOlvido"
        app:layout_constraintBottom_toTopOf="@id/spacerOlvidoSocial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/spacerOlvidoSocial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvOlvidoContrasena"
        app:layout_constraintBottom_toTopOf="@id/contenedorSocial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.7" />

    <LinearLayout
        android:id="@+id/contenedorSocial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/spacerOlvidoSocial"
        app:layout_constraintBottom_toTopOf="@id/spacerSocialFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSeparadorSocial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/o_inicia_con"
            android:textColor="@color/color_negrita"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgGoogle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_google" />

    </LinearLayout>

    <View
        android:id="@+id/spacerSocialFooter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorSocial"
        app:layout_constraintBottom_toTopOf="@id/tvAunSinCuenta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.45" />

    <TextView
        android:id="@+id/tvAunSinCuenta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/aun_sin_cuenta"
        android:textColor="@color/color_negrita"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/spacerSocialFooter"
        app:layout_constraintBottom_toTopOf="@id/spacerBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/spacerBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvAunSinCuenta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>