<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenidoDetalle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clank_background_light"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/crear_padding_bottom">

            <!-- Portada con título encima -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/crear_portada_height">

                <ImageView
                    android:id="@+id/ivPortada"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/tarjeta_portada_desc"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:shadowColor="@color/color_circulo_opciones"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="@color/clank_background_light"
                        android:textSize="@dimen/text_screen_title" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tvNumLikesDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="0"
                            android:textSize="@dimen/text_body_small"
                            android:textColor="@color/clank_background_light"
                            android:fontFamily="@font/poppins_family"
                            android:shadowColor="@color/color_circulo_opciones"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4" />

                        <ImageView
                            android:id="@+id/btnLikeDetalle"
                            android:layout_width="@dimen/tarjeta_btn_opciones_size"
                            android:layout_height="@dimen/tarjeta_btn_opciones_size"
                            android:src="@drawable/ic_like_inactivo"
                            android:background="@drawable/bg_circulo_opciones_inactivo"
                            android:padding="@dimen/space_xs"
                            android:contentDescription="@string/tarjeta_likes_desc" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Cabecera del usuario que publicó el clank -->
            <include
                android:id="@+id/cabeceraUsuario"
                layout="@layout/item_cabecera_usuario" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="@dimen/crear_campo_margin_top"
                android:fontFamily="@font/poppins_family"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/color_negrita"
                android:textSize="@dimen/text_body" />

            <!-- Tiempo -->
            <TextView
                style="@style/Crear.LabelSeccion"
                android:layout_marginTop="@dimen/crear_primera_seccion_margin_top"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/crear_campo_tiempo"
                android:textColor="@color/color_clank_activo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="@dimen/crear_campo_margin_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="2" />

                <ImageButton
                    android:id="@+id/btnTiempoCohete"
                    android:layout_width="@dimen/crear_btn_tiempo_size"
                    android:layout_height="@dimen/crear_btn_tiempo_size"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_boton_tiempo"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="@dimen/crear_btn_tiempo_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cohete"
                    app:tint="@color/color_texto_inactivo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1.5" />

                <ImageButton
                    android:id="@+id/btnTiempoLiebre"
                    android:layout_width="@dimen/crear_btn_tiempo_size"
                    android:layout_height="@dimen/crear_btn_tiempo_size"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_boton_tiempo"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="@dimen/crear_btn_tiempo_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_liebre"
                    app:tint="@color/color_texto_inactivo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1.5" />

                <ImageButton
                    android:id="@+id/btnTiempoTortuga"
                    android:layout_width="@dimen/crear_btn_tiempo_size"
                    android:layout_height="@dimen/crear_btn_tiempo_size"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_boton_tiempo"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="@dimen/crear_btn_tiempo_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tortuga"
                    app:tint="@color/color_texto_inactivo" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="2" />

            </LinearLayout>

            <!-- Materiales -->
            <TextView
                style="@style/Crear.LabelSeccion"
                android:layout_marginTop="@dimen/crear_seccion_margin_top"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/crear_campo_materiales"
                android:textColor="@color/color_clank_activo" />

            <LinearLayout
                android:id="@+id/llContenedorMateriales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="@dimen/crear_campo_margin_top"
                android:orientation="vertical" />

            <!-- Herramientas -->
            <TextView
                android:id="@+id/tvTituloHerramientas"
                style="@style/Crear.LabelSeccion"
                android:layout_marginTop="@dimen/crear_seccion_margin_top"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/crear_campo_herramientas"
                android:textColor="@color/color_clank_activo" />

            <LinearLayout
                android:id="@+id/llContenedorHerramientas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="@dimen/crear_campo_margin_top"
                android:orientation="vertical" />

            <!-- Instrucciones -->
            <TextView
                style="@style/Crear.LabelSeccion"
                android:layout_marginTop="@dimen/crear_seccion_margin_top"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/crear_campo_instrucciones"
                android:textColor="@color/color_clank_activo" />

            <LinearLayout
                android:id="@+id/llContenedorInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="@dimen/crear_campo_margin_top"
                android:orientation="vertical" />

            <!-- Categorías -->
            <TextView
                style="@style/Crear.LabelSeccion"
                android:layout_marginTop="@dimen/crear_seccion_margin_top"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/crear_campo_categorias"
                android:textColor="@color/color_clank_activo" />

          <LinearLayout
            android:id="@+id/contenedorCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/crear_campo_margin_top"
            android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/overlayCargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clank_background_light"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <include
            layout="@layout/vista_cargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</FrameLayout>
